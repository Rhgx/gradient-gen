{
  "name": "gradient-gen-web",
  "version": "1.0.1",
  "type": "module",
  "description": "A static Vite + TypeScript Roblox RichText gradient generator with build-time font scraping.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape:fonts": "tsx scripts/scrape-fonts.ts",
    "sync:preview-fonts": "tsx scripts/sync-preview-fonts.ts",
    "prebuild": "npm run scrape:fonts && npm run sync:preview-fonts"
  },
  "keywords": [
    "roblox",
    "gradient",
    "richtext",
    "vite",
    "typescript"
  ],
  "author": "Rocks",
  "license": "GPL-3.0-only",
  "dependencies": {
    "jsdom": "^26.1.0",
    "sortablejs": "^1.15.6"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
